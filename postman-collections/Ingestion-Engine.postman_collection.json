  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Check login status matches expectation (default 200)\r\nconst expectedLoginStatus = pm.iterationData.get(\"login_expected_status\") || 200;\r\n\r\npm.test(`[Auth] Login status code is ${expectedLoginStatus}`, function () {\r\n    pm.response.to.have.status(expectedLoginStatus);\r\n});\r\n\r\n// If login succeeded, automatically save access_token to collection variables\r\nif (pm.response.code === 200) {\r\n    const data = pm.response.json();\r\n    pm.collectionVariables.set(\"access_token\", data.access_token);\r\n    pm.collectionVariables.set(\"current_user\", data.username);\r\n    pm.collectionVariables.set(\"current_role\", data.role);\r\n    console.log(`Saved token for ${data.username} (${data.role})`);\r\n}\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\":{{username}},\r\n    \"password\":{{password}}\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/auth/login",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get current user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code==200){\r\n    const data = pm.response.json();\r\n    pm.collectionVariables.set(\"userid\",data.user_id);\r\n    pm.collectionVariables.set(\"role\",data.role);\r\n}"
            ]
          }
        }
      ],
